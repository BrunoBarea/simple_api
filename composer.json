{
    "name": "app/simple_api",
    "type": "project",
    "license": "proprietary",
    "description": "Simple API built with Symfony 7",
    "require": {
        "php": ">=8.2",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "symfony/flex": "^2.4",
        "symfony/framework-bundle": "^7.1",
        "symfony/console": "^7.1",
        "symfony/dotenv": "^7.1",
        "symfony/runtime": "^7.1",
        "symfony/yaml": "^7.1",
        "symfony/http-client": "^7.1",
        "symfony/mailer": "^7.1",
        "symfony/serializer": "^7.1",
        "symfony/security-bundle": "^7.1",
        "symfony/validator": "^7.1",
        "doctrine/orm": "^3.3",
        "doctrine/doctrine-bundle": "^2.13",
        "doctrine/doctrine-migrations-bundle": "^3.3"
    },
    "require-dev": {
        "symfony/debug-bundle": "^7.1",
        "symfony/maker-bundle": "^1.60",
        "symfony/profiler-pack": "^1.0",
        "symfony/test-pack": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true
        },
        "sort-packages": true
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "^7.1"
        }
    }
}
